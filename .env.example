# === App ===
# Public URL of this app. Used to build absolute URLs for auth redirects,
# metadata, and emails (e.g. https://myapp.com in production).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Starter Kit"

# === Supabase ===
# Found in your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-only. Never expose this to the client. Used for admin/service tasks
# (e.g. Supabase Edge Functions, background jobs, RLS bypass operations).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# === OAuth (configure providers in Supabase Dashboard > Authentication) ===
# No client-side env vars needed for OAuth — provider credentials are
# configured directly in the Supabase Dashboard, not in this app.
